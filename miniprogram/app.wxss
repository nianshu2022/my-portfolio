@import "styles/tokens.wxss";
@import "styles/typography.wxss";
@import "styles/motion.wxss";

page {
  min-height: 100vh;
  color: var(--text-body);
  background:
    radial-gradient(circle at 14% 0%, rgba(139, 92, 246, 0.15) 0, transparent 34%),
    radial-gradient(circle at 92% 8%, rgba(34, 197, 94, 0.12) 0, transparent 28%),
    linear-gradient(180deg, var(--bg-page) 0%, var(--bg-soft) 48%, var(--bg-page-warm) 100%);
  font-family: "PingFang SC", "Helvetica Neue", -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
}

@media (prefers-color-scheme: dark) {
  page {
    background: 
      radial-gradient(circle at 14% 0%, rgba(124, 58, 237, 0.18) 0, transparent 34%),
      radial-gradient(circle at 92% 8%, rgba(16, 185, 129, 0.12) 0, transparent 28%),
      linear-gradient(180deg, #0b0f1a 0%, #14142b 100%);
  }
}

view,
text,
button,
input,
navigator,
image,
scroll-view {
  box-sizing: border-box;
}

button {
  display: block;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 0;
  background: transparent;
  color: inherit;
  line-height: inherit;
  text-align: inherit;
}

button::after {
  border: 0;
}

.page {
  min-height: 100vh;
  padding: calc(24rpx + env(safe-area-inset-top)) var(--space-page) calc(190rpx + env(safe-area-inset-bottom));
}

.section {
  margin-top: 30rpx;
}

.page-header {
  position: relative;
  overflow: hidden;
  padding: 34rpx 28rpx;
  border: 1rpx solid var(--line);
  border-radius: var(--radius-xl);
  background: linear-gradient(135deg, var(--bg-card), var(--bg-soft));
  box-shadow: var(--shadow-soft);
}

.page-header::after {
  content: "";
  position: absolute;
  right: -60rpx;
  top: -76rpx;
  width: 210rpx;
  height: 210rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, rgba(99,102,241,0.22), rgba(34,197,94,0.18));
}

.eyebrow {
  position: relative;
  z-index: 1;
  color: var(--brand-deep);
  font-size: 21rpx;
  font-weight: 860;
  letter-spacing: 1.1px;
  text-transform: uppercase;
}

.title {
  position: relative;
  z-index: 1;
  margin-top: 10rpx;
  color: var(--text-title);
  font-size: 48rpx;
  font-weight: 880;
  line-height: 1.15;
}

.subtitle {
  position: relative;
  z-index: 1;
  max-width: 600rpx;
  margin-top: 12rpx;
  color: var(--text-sub);
  font-size: 26rpx;
  line-height: 1.66;
}

.section-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 18rpx;
  color: var(--text-title);
  font-size: 31rpx;
  font-weight: 820;
}

.muted {
  color: var(--text-sub);
  font-size: 24rpx;
  font-weight: 500;
}

.card {
  display: block;
  width: 100%;
  max-width: 100%;
  padding: 26rpx;
  border: 1rpx solid var(--line);
  border-radius: var(--radius-lg);
  background: var(--bg-elevated);
  box-shadow: var(--shadow-card);
  text-align: left;
}

.card + .card,
.list-card + .list-card,
.tag-result-card + .tag-result-card,
.essay-card + .essay-card {
  margin-top: 16rpx;
}

.card-title {
  display: -webkit-box;
  overflow: hidden;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  color: var(--text-title);
  font-size: 31rpx;
  font-weight: 820;
  line-height: 1.42;
  word-break: break-all;
}

.card-desc {
  display: -webkit-box;
  overflow: hidden;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
  margin-top: 10rpx;
  color: var(--text-sub);
  font-size: 25rpx;
  line-height: 1.66;
  word-break: break-all;
}

/* Global Card Optimization Classes */
.log-title, .discover-title {
  display: -webkit-box;
  overflow: hidden;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  word-break: break-all;
}

.log-desc, .discover-desc {
  display: -webkit-box;
  overflow: hidden;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
  word-break: break-all;
}

.state {
  margin-top: 22rpx;
  padding: 44rpx 30rpx;
  border: 1rpx dashed var(--line);
  border-radius: var(--radius-lg);
  color: var(--text-sub);
  background: var(--bg-elevated);
  font-size: 27rpx;
  line-height: 1.62;
  text-align: center;
}

.surface-panel {
  border: 1rpx solid var(--line);
  border-radius: var(--radius-xl);
  background: rgba(255, 255, 255, 0.82);
  box-shadow: var(--shadow-soft);
}

.action-button {
  min-height: 86rpx;
  padding: 0 26rpx;
  border-radius: 999rpx;
  color: var(--text-inverse);
  background: linear-gradient(135deg, var(--brand), var(--accent-violet));
  box-shadow: 0 14rpx 28rpx rgba(99, 102, 241, 0.22);
  font-size: 27rpx;
  font-weight: 800;
  line-height: 86rpx;
  text-align: center;
}

.secondary-button {
  color: var(--brand-deep);
  background: var(--brand-soft);
  box-shadow: none;
}

.ghost-button {
  color: var(--text-sub);
  background: var(--bg-glass);
  box-shadow: none;
}

.action-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
  margin-top: 24rpx;
}

.meta-row {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 10rpx;
  margin-top: 18rpx;
}

.pill {
  display: inline-flex;
  max-width: 100%;
  min-height: 42rpx;
  align-items: center;
  padding: 8rpx 14rpx;
  border: 1rpx solid rgba(99, 102, 241, 0.16);
  border-radius: 999rpx;
  color: var(--text-sub);
  background: rgba(238, 242, 255, 0.82);
  font-size: 22rpx;
  font-weight: 650;
  line-height: 1.2;
  word-break: break-all;
}

.type-pill {
  color: var(--brand-deep);
  border-color: rgba(99, 102, 241, 0.22);
  background: var(--brand-soft);
}

.input {
  width: 100%;
  min-height: 78rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  color: var(--text-title);
  background: rgba(255,255,255,0.92);
  font-size: 26rpx;
}

.retry {
  width: 240rpx;
  margin: 24rpx auto 0;
}

.empty-card {
  position: relative;
  overflow: hidden;
  margin-top: 22rpx;
  padding: 44rpx 30rpx;
  border: 1rpx dashed rgba(99, 102, 241, 0.24);
  border-radius: 34rpx;
  background: rgba(255, 255, 255, 0.78);
  box-shadow: 0 12rpx 32rpx rgba(67, 56, 202, 0.08);
  text-align: center;
}

.empty-card.error {
  border-color: rgba(251, 113, 133, 0.28);
  background: linear-gradient(135deg, rgba(255,255,255,0.86), rgba(255,241,242,0.78));
}

.empty-card.soft {
  border-style: solid;
  background: linear-gradient(135deg, rgba(255,255,255,0.86), rgba(238,242,255,0.78));
}

.empty-orbit {
  position: relative;
  width: 120rpx;
  height: 74rpx;
  margin: 0 auto 18rpx;
}

.empty-dot {
  position: absolute;
  border-radius: 999rpx;
}

.dot-a {
  left: 12rpx;
  top: 12rpx;
  width: 58rpx;
  height: 58rpx;
  background: linear-gradient(135deg, #6366f1, #8b5cf6);
  box-shadow: 0 10rpx 24rpx rgba(99,102,241,0.22);
}

.dot-b {
  right: 16rpx;
  top: 0;
  width: 42rpx;
  height: 42rpx;
  background: #dcfce7;
}

.dot-c {
  right: 38rpx;
  bottom: 4rpx;
  width: 24rpx;
  height: 24rpx;
  background: #fff1f2;
}

.empty-title {
  color: #17113f;
  font-size: 31rpx;
  font-weight: 900;
  line-height: 1.35;
}

.empty-desc {
  max-width: 520rpx;
  margin: 10rpx auto 0;
  color: #6b7193;
  font-size: 25rpx;
  line-height: 1.62;
}

.empty-action {
  display: inline-flex;
  min-width: 210rpx;
  min-height: 72rpx;
  align-items: center;
  justify-content: center;
  margin: 24rpx auto 0;
  padding: 0 28rpx;
  border-radius: 999rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #6366f1, #8b5cf6);
  box-shadow: 0 14rpx 30rpx rgba(99, 102, 241, 0.22);
  font-size: 25rpx;
  font-weight: 850;
  line-height: 72rpx;
}

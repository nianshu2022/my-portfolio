<view class="empty-card {{tone}}">
  <view class="empty-orbit">
    <view class="empty-dot dot-a"></view>
    <view class="empty-dot dot-b"></view>
    <view class="empty-dot dot-c"></view>
  </view>
  <view class="empty-title">{{title}}</view>
  <view class="empty-desc">{{desc}}</view>
  <navigator wx:if="{{url && actionText}}" class="empty-action pressable" url="{{url}}">{{actionText}}</navigator>
  <button wx:elif="{{actionText}}" class="empty-action pressable" bindtap="onAction">{{actionText}}</button>
</view>

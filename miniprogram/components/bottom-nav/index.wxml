<view class="tab-host">
  <view class="tab-blur"></view>
  <view class="tab-shell">
    <view
      wx:for="{{list}}"
      wx:key="pagePath"
      class="tab-item {{selected === index ? 'active' : ''}}"
      data-path="{{item.pagePath}}"
      bindtap="switchTab"
    >
      <view class="tab-orb">
        <text>{{item.mark}}</text>
      </view>
      <text class="tab-text">{{item.text}}</text>
    </view>
  </view>
</view>

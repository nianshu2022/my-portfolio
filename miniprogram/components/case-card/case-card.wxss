.case-card {
  background: var(--bg-card);
  border: 1rpx solid var(--border-color);
  padding: var(--space-lg);
  margin-bottom: var(--space-md);
  position: relative;
  transition: transform var(--transition-fast);
}

.case-card:active {
  transform: scale(0.98);
}

.case-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 6rpx;
  height: 100%;
  background: var(--color-primary);
}

.case-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--space-md);
}

.case-number-badge {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 4rpx 16rpx;
  background: var(--color-primary);
}

.case-number-badge .number {
  font-family: var(--font-mono);
  font-size: 24rpx;
  font-weight: 700;
  color: var(--text-inverse);
  letter-spacing: 2rpx;
}

.case-stamp {
  padding: 4rpx 12rpx;
  border: 2rpx solid var(--color-primary);
}

.case-stamp text {
  font-size: 20rpx;
  font-weight: 600;
  color: var(--color-primary);
  letter-spacing: 2rpx;
}

.case-body {
  margin-bottom: var(--space-md);
}

.case-title {
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  font-size: var(--font-subtitle);
  font-weight: 600;
  color: var(--text-title);
  line-height: 1.4;
  margin-bottom: var(--space-sm);
}

.case-excerpt {
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  font-size: var(--font-caption);
  color: var(--text-sub);
  line-height: 1.5;
}

.case-footer {
  display: flex;
  flex-direction: column;
  gap: var(--space-sm);
}

.case-tags {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-xs);
}

.tag {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 12rpx;
  background: var(--bg-page);
  border: 1rpx solid var(--border-color);
  font-size: 20rpx;
  color: var(--text-sub);
}

.case-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.case-date {
  font-size: 22rpx;
  color: var(--text-muted);
}

.case-no {
  font-family: var(--font-mono);
  font-size: 20rpx;
  color: var(--text-muted);
  letter-spacing: 1rpx;
}

.skeleton-list {
  display: grid;
  gap: 16rpx;
  margin-top: 22rpx;
}

.skeleton-card {
  overflow: hidden;
  padding: 26rpx;
  border: 1rpx solid rgba(99, 102, 241, 0.12);
  border-radius: 30rpx;
  background: rgba(255,255,255,0.78);
  box-shadow: 0 12rpx 30rpx rgba(67, 56, 202, 0.07);
}

.sk-row,
.sk-chip {
  position: relative;
  overflow: hidden;
  border-radius: 999rpx;
  background: #eef2ff;
}

.sk-row::after,
.sk-chip::after {
  content: "";
  position: absolute;
  inset: 0;
  transform: translateX(-100%);
  background: linear-gradient(90deg, transparent, rgba(255,255,255,0.75), transparent);
  animation: shimmer 1300ms ease-in-out infinite;
}

.sk-row.top {
  width: 42%;
  height: 28rpx;
}

.sk-row.title {
  width: 86%;
  height: 42rpx;
  margin-top: 22rpx;
}

.sk-row.body {
  width: 100%;
  height: 30rpx;
  margin-top: 18rpx;
}

.sk-chip-row {
  display: flex;
  gap: 10rpx;
  margin-top: 22rpx;
}

.sk-chip {
  width: 128rpx;
  height: 42rpx;
}

.sk-chip.short {
  width: 92rpx;
}

.skeleton-list.compact .skeleton-card {
  padding: 22rpx;
}

.skeleton-list.compact .sk-row.title {
  height: 34rpx;
}

@keyframes shimmer {
  100% {
    transform: translateX(100%);
  }
}

<view class="page-tags">
  <!-- 标签云 -->
  <view class="tags-section">
    <view class="section-header">
      <text class="section-title">标签索引</text>
      <text class="section-count">{{tags.length}} 个标签</text>
    </view>
    
    <view class="tags-cloud">
      <tag-chip
        wx:for="{{tags}}"
        wx:key="name"
        text="{{item.name}}"
        count="{{item.count}}"
        active="{{activeTag === item.name}}"
        bindtap="onTagTap"
      />
    </view>
  </view>

  <!-- 筛选结果 -->
  <view class="result-section">
    <view class="result-header" wx:if="{{activeTag}}">
      <text class="result-tag">筛选: {{activeTag}}</text>
      <text class="result-count">{{filteredPosts.length}} 份案卷</text>
    </view>

    <skeleton-list wx:if="{{loading}}" count="5" />

    <block wx:elif="{{filteredPosts.length > 0}}">
      <case-card
        wx:for="{{filteredPosts}}"
        wx:key="slug"
        title="{{item.title}}"
        date="{{item.date}}"
        tags="{{item.tags}}"
        caseNumber="{{caseNumbers[item.slug]}}"
        type="post"
        slug="{{item.slug}}"
        bindtap="onCaseTap"
      />
    </block>

    <empty-state 
      wx:else 
      icon="🔍" 
      title="暂无匹配案卷" 
      desc="{{activeTag ? '该标签下暂无内容' : '正在整理中'}}" 
    />
  </view>
</view>

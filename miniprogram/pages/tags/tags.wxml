<view class="page-tags">
  <!-- 页面标题 -->
  <view class="page-header">
    <view class="header-left">
      <text class="header-code">IDX</text>
      <text class="header-title">案卷索引</text>
    </view>
    <text class="header-count">{{tags.length}} 个标签</text>
  </view>

  <!-- 标签云 -->
  <view class="tags-section">
    <view class="tags-cloud">
      <view 
        class="tag-chip {{activeTag === item.name ? 'active' : ''}}"
        wx:for="{{tags}}"
        wx:key="name"
        data-name="{{item.name}}"
        bindtap="onTagTap"
      >
        <text class="tag-name">{{item.name}}</text>
        <text class="tag-count">{{item.count}}</text>
      </view>
    </view>
  </view>

  <!-- 筛选结果 -->
  <view class="result-section" wx:if="{{activeTag}}">
    <view class="result-header">
      <text class="result-tag">{{activeTag}}</text>
      <text class="result-count">{{filteredPosts.length}} 份案卷</text>
    </view>

    <skeleton-list wx:if="{{loading}}" count="5" />

    <block wx:elif="{{filteredPosts.length > 0}}">
      <case-card
        wx:for="{{filteredPosts}}"
        wx:key="slug"
        title="{{item.title}}"
        date="{{item.date}}"
        tags="{{item.tags}}"
        caseNumber="{{caseNumbers[item.slug]}}"
        type="post"
        slug="{{item.slug}}"
        bindtap="onCaseTap"
      />
    </block>

    <empty-state 
      wx:else 
      icon="empty" 
      title="暂无匹配案卷" 
      desc="换个标签试试" 
    />
  </view>
</view>

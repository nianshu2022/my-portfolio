.discover-page {
  padding-bottom: 220rpx;
}

.tags-header {
  margin-bottom: 20rpx;
}

.discover-tools {
  position: sticky;
  top: 0;
  z-index: 4;
  padding: 10rpx 14rpx;
  border: 1rpx solid var(--line);
  border-radius: var(--radius-xl);
  background: var(--bg-glass);
  box-shadow: var(--shadow-soft);
  backdrop-filter: blur(20rpx);
}

.search-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 0 8rpx;
  border-radius: 999rpx;
  background: var(--bg-soft);
}

.search-row.single-tool {
  padding-right: 14rpx;
}

.search-icon {
  flex: none;
  width: 46rpx;
  color: var(--brand-deep);
  font-size: 30rpx;
  text-align: center;
}

.search-input {
  flex: 1;
  background: transparent;
  font-size: 26rpx;
}

.search-clear-btn {
  display: flex;
  width: 44rpx;
  height: 44rpx;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  background: rgba(99, 102, 241, 0.12);
  transition: opacity 0.2s;
}

.search-clear-btn:active {
  opacity: 0.6;
}

.clear-x {
  color: var(--brand);
  font-size: 32rpx;
  font-weight: 300;
  line-height: 1;
}

.discover-summary {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-top: 28rpx;
  margin-bottom: 16rpx;
}

.summary-title,
.summary-desc {
  display: block;
}

.summary-title {
  color: var(--text-title);
  font-size: 32rpx;
  font-weight: 900;
}

.summary-desc {
  margin-top: 6rpx;
  color: var(--text-sub);
  font-size: 23rpx;
  line-height: 1.45;
}

.discover-list {
  display: grid;
  gap: 16rpx;
}

.discover-card {
  display: block;
  width: 100%;
  padding: 26rpx;
  border: 1rpx solid var(--line);
  border-radius: var(--radius-lg);
  background: linear-gradient(145deg, var(--bg-card), var(--bg-soft));
  box-shadow: var(--shadow-soft);
}

.discover-card-top {
  display: flex;
  gap: 10rpx;
  margin-bottom: 14rpx;
}

.discover-title {
  display: -webkit-box;
  overflow: hidden;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  color: var(--text-title);
  font-size: 32rpx;
  font-weight: 900;
  line-height: 1.38;
  word-break: break-all;
}

.discover-desc {
  display: -webkit-box;
  overflow: hidden;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
  margin-top: 10rpx;
  color: var(--text-sub);
  font-size: 25rpx;
  line-height: 1.62;
  word-break: break-all;
}

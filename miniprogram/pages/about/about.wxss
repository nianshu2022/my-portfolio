.about-v4 {
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
}

/* 1. Profile Poster Hero */
.hero-poster {
  position: relative;
  margin-top: 10rpx;
  padding: 40rpx 40rpx 30rpx;
  border-radius: 48rpx;
  background: linear-gradient(145deg, var(--bg-card), var(--bg-soft));
  box-shadow: var(--shadow-card);
  text-align: center;
  overflow: hidden;
}

@media (prefers-color-scheme: dark) {
  .hero-poster {
    background: linear-gradient(145deg, #1e293b 0%, #064e3b 100%);
  }
}

.hero-backdrop {
  position: absolute;
  top: -50rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 300rpx;
  height: 300rpx;
  background: radial-gradient(circle, rgba(99, 102, 241, 0.15) 0%, transparent 70%);
  border-radius: 50%;
  pointer-events: none;
}

.avatar-ring-container {
  position: relative;
  width: 170rpx;
  height: 170rpx;
  margin: 0 auto 20rpx;
}

.avatar-img {
  position: relative;
  z-index: 10;
  width: 100%;
  height: 100%;
  border-radius: 50rpx;
  border: 6rpx solid var(--bg-card);
  box-shadow: 0 16rpx 40rpx rgba(99, 102, 241, 0.15);
}

.halo {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  border-radius: 50%;
  border: 2rpx dashed rgba(99, 102, 241, 0.3);
}

.halo-1 {
  width: 210rpx;
  height: 210rpx;
  animation: spin 20s linear infinite;
}

.halo-2 {
  width: 240rpx;
  height: 240rpx;
  border-style: dotted;
  border-color: rgba(34, 197, 94, 0.2);
  animation: spin-reverse 25s linear infinite;
}

@keyframes spin { 100% { transform: translate(-50%, -50%) rotate(360deg); } }
@keyframes spin-reverse { 100% { transform: translate(-50%, -50%) rotate(-360deg); } }

.hero-name {
  color: var(--text-title);
  font-size: 56rpx;
  font-weight: 900;
  letter-spacing: 2rpx;
}

.hero-title {
  margin-top: 8rpx;
  color: var(--brand-deep);
  font-size: 24rpx;
  font-weight: 860;
  letter-spacing: 1px;
  text-transform: uppercase;
}

.glass-bio {
  position: relative;
  margin-top: 30rpx;
  padding: 24rpx 36rpx;
  border-radius: 32rpx;
  background: var(--bg-glass);
  border: 1rpx solid var(--line);
  color: var(--text-body);
  font-size: 26rpx;
  line-height: 1.6;
  text-align: left;
  backdrop-filter: blur(10px);
}

.bio-quotes {
  color: var(--brand);
  font-size: 40rpx;
  font-family: serif;
  font-weight: 900;
  opacity: 0.3;
}
.bio-quotes.left { margin-right: 8rpx; }
.bio-quotes.right { margin-left: 8rpx; }

/* Section Title Common */
.section { margin-top: 32rpx; }
.section-title {
  margin-bottom: 16rpx;
  padding-left: 8rpx;
  color: var(--text-title);
  font-size: 34rpx;
  font-weight: 900;
}

/* 2. Connect Garden (Premium List) */
.connect-list-premium {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.premium-card {
  display: flex;
  align-items: center;
  padding: 24rpx 32rpx;
  background: var(--bg-card);
  border-radius: 40rpx;
  border: 1rpx solid var(--line);
  box-shadow: var(--shadow-soft);
}

.pc-icon-box {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 96rpx;
  height: 96rpx;
  border-radius: 28rpx;
  margin-right: 28rpx;
  flex: none;
  background-size: 44rpx 44rpx;
  background-repeat: no-repeat;
  background-position: center;
}


.page-about {
  min-height: 100vh;
  background: var(--bg-page);
}

/* 个人简介 */
.profile-section {
  padding: var(--space-lg);
}

.profile-card {
  background: var(--bg-card);
  border: 1rpx solid var(--border-color);
  padding: var(--space-xl);
  position: relative;
}

.profile-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 6rpx;
  height: 100%;
  background: var(--color-primary);
}

.serial-tag {
  display: inline-flex;
  align-items: center;
  padding: 6rpx 16rpx;
  background: var(--color-primary);
  color: var(--text-inverse);
  font-family: var(--font-mono);
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  margin-bottom: var(--space-lg);
}

.profile-header {
  display: flex;
  align-items: center;
  gap: var(--space-lg);
  margin-bottom: var(--space-lg);
}

.avatar {
  width: 100rpx;
  height: 100rpx;
  background: var(--color-primary);
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-text {
  font-size: 48rpx;
  font-weight: 800;
  color: var(--text-inverse);
}

.profile-info {
  flex: 1;
}

.profile-name {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-title);
  margin-bottom: var(--space-xs);
}

.profile-title {
  font-size: var(--font-caption);
  color: var(--text-sub);
}

.profile-meta {
  background: var(--bg-page);
  border: 1rpx solid var(--border-color);
  padding: var(--space-lg);
  margin-bottom: var(--space-lg);
}

.meta-item {
  display: flex;
  align-items: center;
  padding: var(--space-sm) 0;
  border-bottom: 1rpx dashed var(--border-color);
}

.meta-item:last-child {
  border-bottom: none;
}

.meta-label {
  width: 120rpx;
  font-size: var(--font-caption);
  color: var(--text-muted);
  flex-shrink: 0;
}

.meta-value {
  font-size: var(--font-body);
  color: var(--text-title);
  font-weight: 500;
}

.meta-value.mono {
  font-family: var(--font-mono);
  letter-spacing: 1rpx;
}

.meta-value.status {
  color: var(--color-primary);
}

.profile-bio {
  font-size: var(--font-body);
  color: var(--text-body);
  line-height: 1.6;
}

/* 时间线 */
.timeline-section {
  padding: var(--space-lg);
}

.section-header {
  margin-bottom: var(--space-lg);
}

.section-title {
  font-size: var(--font-subtitle);
  font-weight: 700;
  color: var(--text-title);
  letter-spacing: 2rpx;
}

.timeline {
  position: relative;
  padding-left: 40rpx;
}

.timeline::before {
  content: '';
  position: absolute;
  left: 16rpx;
  top: 0;
  bottom: 0;
  width: 2rpx;
  background: var(--border-color);
}

.timeline-item {
  position: relative;
  padding-bottom: var(--space-xl);
}

.timeline-dot {
  position: absolute;
  left: -32rpx;
  top: 12rpx;
  width: 12rpx;
  height: 12rpx;
  background: var(--color-primary);
  border-radius: 50%;
}

.timeline-content {
  background: var(--bg-card);
  border: 1rpx solid var(--border-color);
  padding: var(--space-lg);
}

.timeline-header {
  display: flex;
  align-items: center;
  gap: var(--space-md);
  margin-bottom: var(--space-sm);
}

.timeline-year {
  font-family: var(--font-mono);
  font-size: var(--font-caption);
  font-weight: 700;
  color: var(--color-primary);
}

.timeline-title {
  font-size: var(--font-body);
  font-weight: 600;
  color: var(--text-title);
}

.timeline-desc {
  font-size: var(--font-caption);
  color: var(--text-sub);
}

/* 外部链接 */
.links-section {
  padding: var(--space-lg);
}

.links-list {
  background: var(--bg-card);
  border: 1rpx solid var(--border-color);
}

.link-item {
  display: flex;
  align-items: center;
  padding: var(--space-lg);
  border-bottom: 1rpx solid var(--border-color);
}

.link-item:last-child {
  border-bottom: none;
}

.link-item:active {
  background: var(--bg-page);
}

.link-icon {
  font-size: 40rpx;
  margin-right: var(--space-md);
}

.link-text {
  flex: 1;
  font-size: var(--font-body);
  font-weight: 500;
  color: var(--text-title);
}

.link-arrow {
  font-size: 24rpx;
  color: var(--text-muted);
}

/* 底部装饰 */
.footer-decor {
  display: flex;
  justify-content: center;
  padding: var(--space-2xl);
  opacity: 0.3;
}

.barcode {
  display: flex;
  align-items: center;
  gap: 4rpx;
}

.barcode-line {
  width: 2rpx;
  height: 20rpx;
  background: var(--text-title);
}

.barcode-line:nth-child(odd) {
  height: 28rpx;
}

.barcode-text {
  font-family: var(--font-mono);
  font-size: 16rpx;
  color: var(--text-muted);
  letter-spacing: 2rpx;
  margin-left: 8rpx;
}

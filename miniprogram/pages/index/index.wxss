.home-v4 {
  padding-top: 24rpx;
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
}

.home-v4 .section {
  margin-top: 28rpx;
}

.hero-shell {
  position: relative;
  overflow: hidden;
  display: grid;
  grid-template-columns: 1fr 140rpx;
  gap: 14rpx;
  min-height: 260rpx;
  padding: 28rpx 30rpx;
  border: 1rpx solid var(--line);
  border-radius: 36rpx;
  background: linear-gradient(135deg, var(--bg-card), var(--bg-soft));
  box-shadow: var(--shadow-card);
}

@media (prefers-color-scheme: dark) {
  .hero-shell {
    background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);
  }
}

.hero-glow {
  position: absolute;
  border-radius: 999rpx;
  filter: blur(4rpx);
}

.hero-glow-a {
  right: -64rpx;
  top: -56rpx;
  width: 230rpx;
  height: 230rpx;
  background: rgba(99, 102, 241, 0.24);
}

.hero-glow-b {
  left: 56rpx;
  bottom: -84rpx;
  width: 260rpx;
  height: 180rpx;
  background: rgba(34, 197, 94, 0.16);
}

.hero-copy,
.hero-copy {
  position: relative;
  z-index: 10;
  max-width: 70%;
}

.hero-kicker {
  color: var(--brand);
  font-size: 18rpx;
  font-weight: 900;
  letter-spacing: 4rpx;
  margin-bottom: 24rpx;
  opacity: 0.8;
}

.hero-title {
  color: var(--text-title);
  font-size: 60rpx;
  font-weight: 900;
  line-height: 1.3;
  margin-bottom: 24rpx;
  letter-spacing: -1rpx;
}

.hero-sub {
  color: var(--text-sub);
  font-size: 26rpx;
  line-height: 1.6;
  font-weight: 500;
}

.hero-visual {
  min-height: 180rpx;
}

.glass-tile {
  position: absolute;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid var(--line);
  border-radius: 28rpx;
  color: var(--brand-deep);
  background: var(--bg-glass);
  box-shadow: var(--shadow-soft);
  backdrop-filter: blur(10px);
  font-size: 20rpx;
  font-weight: 900;
  letter-spacing: 0.8px;
}

.tile-a { right: 0; top: 4rpx; width: 110rpx; height: 86rpx; transform: rotate(7deg); }
.tile-b { left: 0; top: 64rpx; width: 116rpx; height: 92rpx; color: #be123c; transform: rotate(-8deg); }
.tile-c { right: 10rpx; bottom: 8rpx; width: 90rpx; height: 74rpx; color: #15803d; transform: rotate(10deg); }

.bento {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
}

.bento-card {
  position: relative;
  overflow: hidden;
  min-height: 154rpx;
  padding: 18rpx 18rpx;
  border: 1rpx solid var(--line);
  border-radius: var(--radius-lg);
  background: var(--bg-elevated);
  box-shadow: var(--shadow-soft);
}

.tech-card {
  background: linear-gradient(160deg, var(--bg-card) 0%, var(--bg-soft) 100%);
}

.essay-card {
  background: linear-gradient(145deg, var(--bg-card) 0%, var(--bg-soft) 100%);
}

.bento-card::after {
  content: "";
  position: absolute;
  inset: 0;
  border-radius: inherit;
  background:
    radial-gradient(circle at 82% 22%, rgba(99,102,241,0.1), transparent 32%),
    radial-gradient(circle at 18% 88%, rgba(34,197,94,0.09), transparent 34%);
  pointer-events: none;
}

.bento-art {
  position: absolute;
  right: 18rpx;
  top: 18rpx;
  z-index: 0;
  width: 116rpx;
  height: 108rpx;
  opacity: 0.9;
  pointer-events: none;
}

.tech-node {
  position: absolute;
  width: 18rpx;
  height: 18rpx;
  border: 4rpx solid rgba(99,102,241,0.34);
  border-radius: 999rpx;
  background: rgba(255,255,255,0.8);
}

.node-a { right: 8rpx; top: 6rpx; }
.node-b { right: 64rpx; top: 38rpx; }
.node-c { right: 20rpx; top: 78rpx; }

.tech-line {
  position: absolute;
  height: 4rpx;
  border-radius: 999rpx;
  background: rgba(99,102,241,0.2);
  transform-origin: left center;
}

.line-a { right: 28rpx; top: 25rpx; width: 54rpx; transform: rotate(150deg); }
.line-b { right: 36rpx; top: 62rpx; width: 50rpx; transform: rotate(38deg); }

.code-mark {
  position: absolute;
  right: 44rpx;
  bottom: 4rpx;
  color: rgba(67,56,202,0.28);
  font-size: 24rpx;
  font-weight: 900;
  letter-spacing: 0;
}

.paper-sheet {
  position: absolute;
  border: 1rpx solid rgba(139,92,246,0.18);
  border-radius: 18rpx;
  background: rgba(255,255,255,0.76);
  box-shadow: 0 12rpx 26rpx rgba(67,56,202,0.08);
}

.sheet-a {
  right: 4rpx;
  top: 8rpx;
  width: 70rpx;
  height: 82rpx;
  transform: rotate(7deg);
}

.sheet-b {
  right: 44rpx;
  top: 30rpx;
  width: 62rpx;
  height: 72rpx;
  transform: rotate(-9deg);
}

.ink-dot {
  position: absolute;
  border-radius: 999rpx;
  background: rgba(34,197,94,0.22);
}

.dot-a { right: 18rpx; bottom: 8rpx; width: 20rpx; height: 20rpx; }
.dot-b { right: 92rpx; top: 10rpx; width: 12rpx; height: 12rpx; background: rgba(251,113,133,0.22); }

.bento-title {
  position: relative;
  z-index: 1;
  color: var(--text-title);
  font-size: 32rpx;
  font-weight: 860;
}

.bento-number-row {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: flex-end;
  gap: 8rpx;
  margin-top: 18rpx;
}

.bento-number {
  color: var(--text-title);
  font-size: 58rpx;
  font-weight: 900;
  line-height: 0.92;
}

.bento-unit {
  padding-bottom: 8rpx;
  color: var(--brand-deep);
  font-size: 23rpx;
  font-weight: 820;
  line-height: 1;
}

.log-grid {
  display: block;
  width: 100%;
  gap: 16rpx;
  margin-top: 16rpx;
}

.log-card {
  display: block;
  width: 100%;
  min-width: 0;
  margin: 0;
  padding: 24rpx 24rpx 22rpx;
  border: 1rpx solid var(--line);
  border-radius: 30rpx;
  background: linear-gradient(135deg, var(--bg-card), var(--bg-soft));
  box-shadow: var(--shadow-soft);
  text-align: left;
}

.log-card + .log-card {
  margin-top: 20rpx;
}

.log-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.log-type { color: var(--brand-deep); font-size: 22rpx; font-weight: 860; }
.log-date { color: var(--text-sub); font-size: 22rpx; }
.log-title {
  display: -webkit-box;
  overflow: hidden;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  color: var(--text-title);
  font-size: 31rpx;
  font-weight: 860;
  line-height: 1.38;
  word-break: break-all;
}
.log-desc {
  display: -webkit-box;
  overflow: hidden;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
  margin-top: 10rpx;
  color: var(--text-body);
  font-size: 24rpx;
  line-height: 1.58;
  word-break: break-all;
}

.chip-row { display: flex; flex-wrap: wrap; gap: 8rpx; margin-top: 16rpx; }
.chip { padding: 7rpx 13rpx; border: 1rpx solid rgba(99,102,241,0.15); border-radius: 999rpx; color: var(--text-sub); background: var(--tag-bg); font-size: 21rpx; }
.chip-reading { border-color: rgba(34,197,94,0.2); color: #15803d; background: #ecfdf5; }

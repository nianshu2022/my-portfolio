.page-index {
  min-height: 100vh;
  background: var(--bg-page);
}

/* 品牌区域 */
.hero-section {
  background: var(--bg-card);
  border-bottom: 2rpx solid var(--border-dark);
  padding: var(--space-2xl) var(--space-lg);
  position: relative;
  overflow: hidden;
}

.hero-section::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-image: 
    linear-gradient(var(--bg-grid) 1px, transparent 1px),
    linear-gradient(90deg, var(--bg-grid) 1px, transparent 1px);
  background-size: 40rpx 40rpx;
  opacity: 0.5;
}

.hero-inner {
  position: relative;
  z-index: 1;
}

.serial-tag {
  display: inline-flex;
  align-items: center;
  padding: 6rpx 16rpx;
  background: var(--color-primary);
  color: var(--text-inverse);
  font-family: var(--font-mono);
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  margin-bottom: var(--space-lg);
}

.hero-title {
  margin-bottom: var(--space-md);
}

.title-main {
  font-size: 48rpx;
  font-weight: 800;
  color: var(--text-title);
  letter-spacing: 4rpx;
}

.hero-desc {
  font-size: var(--font-body);
  color: var(--text-sub);
  margin-bottom: var(--space-xl);
}

.id-card {
  background: var(--bg-page);
  border: 1rpx solid var(--border-color);
  padding: var(--space-lg);
}

.id-row {
  display: flex;
  align-items: center;
  padding: var(--space-sm) 0;
  border-bottom: 1rpx dashed var(--border-color);
}

.id-row:last-child {
  border-bottom: none;
}

.id-label {
  width: 160rpx;
  font-size: var(--font-caption);
  color: var(--text-muted);
  flex-shrink: 0;
}

.id-value {
  font-size: var(--font-body);
  color: var(--text-title);
  font-weight: 500;
}

.id-value.mono {
  font-family: var(--font-mono);
  letter-spacing: 1rpx;
}

.id-value.status {
  color: var(--color-primary);
}

/* 统计区域 */
.stats-section {
  display: flex;
  background: var(--bg-card);
  border-bottom: 1rpx solid var(--border-color);
  padding: var(--space-lg) 0;
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--space-xs);
}

.stat-num {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--color-primary);
  font-family: var(--font-mono);
}

.stat-label {
  font-size: var(--font-caption);
  color: var(--text-muted);
}

/* 区块 */
.section {
  padding: var(--space-lg);
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--space-lg);
}

.section-title {
  font-size: var(--font-subtitle);
  font-weight: 700;
  color: var(--text-title);
  letter-spacing: 2rpx;
}

.section-more {
  display: flex;
  align-items: center;
  gap: var(--space-xs);
  font-size: var(--font-caption);
  color: var(--text-muted);
}

.arrow {
  font-size: 24rpx;
}

/* 快捷入口 */
.quick-entry {
  display: flex;
  gap: var(--space-md);
  padding: 0 var(--space-lg);
  margin-bottom: var(--space-xl);
}

.entry-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--space-sm);
  padding: var(--space-lg);
  background: var(--bg-card);
  border: 1rpx solid var(--border-color);
}

.entry-item:active {
  background: var(--bg-page);
}

.entry-icon {
  font-size: 48rpx;
}

.entry-text {
  font-size: var(--font-caption);
  color: var(--text-body);
  font-weight: 500;
}

/* 底部装饰 */
.footer-decor {
  display: flex;
  justify-content: center;
  padding: var(--space-2xl);
  opacity: 0.3;
}

.barcode {
  display: flex;
  align-items: center;
  gap: 4rpx;
}

.barcode-line {
  width: 2rpx;
  height: 20rpx;
  background: var(--text-title);
}

.barcode-line:nth-child(odd) {
  height: 28rpx;
}

.barcode-text {
  font-family: var(--font-mono);
  font-size: 16rpx;
  color: var(--text-muted);
  letter-spacing: 2rpx;
  margin-left: 8rpx;
}

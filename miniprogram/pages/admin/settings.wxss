.admin-settings {
  padding-bottom: 60rpx;
}

.admin-header {
  padding: 40rpx 28rpx;
  background: linear-gradient(135deg, var(--bg-card), var(--bg-soft));
}

.admin-title {
  color: var(--text-title);
  font-size: 42rpx;
  font-weight: 900;
}

.admin-sub {
  margin-top: 6rpx;
  color: var(--text-sub);
  font-size: 24rpx;
}

.settings-form {
  padding: 40rpx 28rpx;
}

.form-group {
  margin-bottom: 40rpx;
}

.label {
  margin-bottom: 16rpx;
  color: var(--text-title);
  font-size: 28rpx;
  font-weight: 800;
}

.input-field {
  width: 100%;
  height: 90rpx;
  padding: 0 24rpx;
  border: 1rpx solid var(--line);
  border-radius: var(--radius-md);
  background: var(--bg-card);
  color: var(--text-title);
  box-sizing: border-box;
}

.textarea-field {
  width: 100%;
  height: 200rpx;
  padding: 24rpx;
  border: 1rpx solid var(--line);
  border-radius: var(--radius-md);
  background: var(--bg-card);
  color: var(--text-title);
  box-sizing: border-box;
}

.save-btn {
  width: 100% !important;
  height: 100rpx;
  margin-top: 60rpx;
  border-radius: var(--radius-md);
  color: #94a3b8;
  background: #f1f5f9;
  border: 1rpx solid #e2e8f0;
  font-size: 32rpx;
  font-weight: 900;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.save-btn.active {
  color: #ffffff;
  background: linear-gradient(135deg, var(--brand), var(--accent-violet));
  border: none;
  box-shadow: 0 12rpx 32rpx var(--brand-soft);
}

.save-btn:active {
  transform: scale(0.97);
  filter: brightness(0.95);
}

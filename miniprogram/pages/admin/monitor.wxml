<view class="page admin-monitor">
  <view class="admin-header fade-enter">
    <view class="admin-title">系统性能监控</view>
    <view class="admin-sub">实时观测云端运行状态与数据健康</view>
  </view>

  <!-- 1. Latency Meter -->
  <view class="section fade-enter" style="animation-delay: 0.1s;">
    <view class="section-title">实时网络延迟 (RTT)</view>
    <view class="latency-card">
      <view class="latency-val {{latency < 100 ? 'good' : (latency < 300 ? 'medium' : 'poor')}}">
        {{latency}} <text class="unit">ms</text>
      </view>
      <view class="latency-label">API 响应耗时</view>
      <view class="latency-bar">
        <view class="bar-fill" style="width: {{latency/5}}%"></view>
      </view>
    </view>
  </view>

  <!-- 2. Database Scale -->
  <view class="section fade-enter" style="animation-delay: 0.2s;">
    <view class="section-title">数据库规模</view>
    <view class="data-grid">
      <view class="data-item">
        <view class="data-num">{{health.database.post_count}}</view>
        <view class="data-name">文章总数</view>
      </view>
      <view class="data-item">
        <view class="data-num">{{health.database.comment_count}}</view>
        <view class="data-name">留言总数</view>
      </view>
      <view class="data-item">
        <view class="data-num">{{health.database.favorite_count}}</view>
        <view class="data-name">收藏总数</view>
      </view>
      <view class="data-item">
        <view class="data-num">{{health.database.stats_count}}</view>
        <view class="data-name">统计索引</view>
      </view>
    </view>
  </view>

  <!-- 3. Environment -->
  <view class="section fade-enter" style="animation-delay: 0.3s;">
    <view class="section-title">运行环境</view>
    <view class="env-list">
      <view class="env-row">
        <text class="env-label">服务商</text>
        <text class="env-val">{{health.platform}}</text>
      </view>
      <view class="env-row">
        <text class="env-label">运行容器</text>
        <text class="env-val">{{health.runtime}}</text>
      </view>
      <view class="env-row">
        <text class="env-label">节点位置</text>
        <text class="env-val">{{health.location}}</text>
      </view>
      <view class="env-row">
        <text class="env-label">基础库</text>
        <text class="env-val">{{libVersion}}</text>
      </view>
    </view>
  </view>

  <button class="refresh-btn" bindtap="refreshAll">一键诊断</button>
</view>

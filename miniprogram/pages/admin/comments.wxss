.admin-comments {
  padding-bottom: 60rpx;
}

.admin-header {
  padding: 40rpx 28rpx;
  background: linear-gradient(135deg, var(--bg-card), var(--bg-soft));
}

.admin-title {
  color: var(--text-title);
  font-size: 42rpx;
  font-weight: 900;
}

.admin-sub {
  margin-top: 6rpx;
  color: var(--text-sub);
  font-size: 24rpx;
}

.comment-list {
  padding: 30rpx 24rpx;
}

.comment-card {
  margin-bottom: 24rpx;
  padding: 24rpx;
  border: 1rpx solid var(--line);
  border-radius: var(--radius-lg);
  background: var(--bg-card);
  box-shadow: var(--shadow-soft);
}

.card-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.user-info {
  display: flex;
  gap: 16rpx;
}

.avatar-mini {
  width: 64rpx;
  height: 64rpx;
  border-radius: 999rpx;
  color: #ffffff;
  background: linear-gradient(135deg, var(--brand), var(--accent-violet));
  font-size: 28rpx;
  font-weight: 900;
  line-height: 64rpx;
  text-align: center;
}

.name-box {
  display: flex;
  flex-direction: column;
}

.user-name {
  color: var(--text-title);
  font-size: 28rpx;
  font-weight: 800;
}

.post-link {
  margin-top: 2rpx;
  color: var(--brand);
  font-size: 20rpx;
}

.delete-btn {
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  color: #f43f5e;
  background: rgba(244, 63, 94, 0.1);
  font-size: 22rpx;
  font-weight: 700;
}

.action-row {
  display: flex;
  gap: 16rpx;
}

.reply-btn {
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  color: var(--brand);
  background: var(--brand-soft);
  font-size: 22rpx;
  font-weight: 700;
}

.admin-reply-box {
  margin-top: 20rpx;
  padding: 20rpx;
  border-left: 6rpx solid var(--brand);
  border-radius: 8rpx;
  background: var(--bg-soft);
}

.reply-header {
  color: var(--brand);
  font-size: 22rpx;
  font-weight: 900;
  margin-bottom: 8rpx;
}

.reply-body {
  color: var(--text-body);
  font-size: 25rpx;
  line-height: 1.5;
}

/* 弹窗样式 */
.reply-sheet {
  position: fixed;
  inset: 0;
  z-index: 2000;
  visibility: hidden;
  transition: all 0.3s ease;
}

.reply-sheet.visible {
  visibility: visible;
}

.sheet-mask {
  position: absolute;
  inset: 0;
  background: rgba(0,0,0,0.6);
  backdrop-filter: blur(4rpx);
  opacity: 0;
  transition: opacity 0.3s ease;
}

.reply-sheet.visible .sheet-mask {
  opacity: 1;
}

.sheet-content {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 40rpx 40rpx calc(40rpx + env(safe-area-inset-bottom));
  border-radius: 40rpx 40rpx 0 0;
  background: var(--bg-card);
  transform: translateY(100%);
  transition: transform 0.3s cubic-bezier(0.23, 1, 0.32, 1);
}

.reply-sheet.visible .sheet-content {
  transform: translateY(0);
}

.sheet-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 40rpx;
  color: var(--text-title);
  font-size: 34rpx;
  font-weight: 900;
}

.sheet-close {
  padding: 10rpx;
  color: var(--text-sub);
  font-size: 40rpx;
}

.reply-input {
  width: 100%;
  height: 240rpx;
  margin-bottom: 40rpx;
  padding: 24rpx 28rpx;
  border: 1rpx solid var(--line);
  border-radius: var(--radius-md);
  background: var(--bg-soft);
  box-sizing: border-box;
  color: var(--text-title);
}

.submit-btn {
  width: 100% !important;
  height: 94rpx;
  border-radius: var(--radius-md);
  color: #ffffff;
  background: #cbd5e1;
  font-size: 30rpx;
  font-weight: 900;
  line-height: 94rpx;
}

.submit-btn.active {
  background: linear-gradient(135deg, var(--brand), var(--accent-violet));
  box-shadow: 0 10rpx 24rpx var(--brand-soft);
}

.comment-body {
  padding: 20rpx;
  border-radius: var(--radius-md);
  color: var(--text-body);
  background: var(--bg-soft);
  font-size: 26rpx;
  line-height: 1.6;
}

.card-footer {
  display: flex;
  justify-content: space-between;
  margin-top: 20rpx;
  color: var(--text-sub);
  font-size: 20rpx;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 100rpx;
  color: var(--text-sub);
}

.empty-icon {
  margin-bottom: 20rpx;
  font-size: 60rpx;
  opacity: 0.5;
}

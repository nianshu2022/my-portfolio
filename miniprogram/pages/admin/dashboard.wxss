.admin-ultimate {
  --bg-page: #f8fafc;
  --bg-card: rgba(255, 255, 255, 0.7);
  --bg-soft: #ffffff;
  --text-title: #1e293b;
  --text-body: #475569;
  --text-sub: #94a3b8;
  --line: rgba(0, 0, 0, 0.04);
  --brand: #4f46e5;
  --accent-violet: #8b5cf6;
  
  min-height: 100vh;
  background: var(--bg-page);
  color: var(--text-title);
  padding-bottom: 60rpx;
}

/* 1.看板区 */
.hero-panel {
  margin: 30rpx 30rpx 40rpx;
  padding: 60rpx 40rpx;
  background: linear-gradient(135deg, #ffffff, #f1f5f9);
  border: 1rpx solid #ffffff;
  border-radius: 48rpx;
  box-shadow: 0 30rpx 80rpx rgba(79, 70, 229, 0.1);
  text-align: center;
}

.panel-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 40rpx;
}

.status-indicator {
  display: flex;
  align-items: center;
  gap: 10rpx;
  color: #10b981;
  font-size: 20rpx;
  font-weight: 800;
}

.dot { width: 10rpx; height: 10rpx; background: #10b981; border-radius: 50%; }
.pulse { animation: pulse 2s infinite; }

@keyframes pulse {
  0% { box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.4); }
  70% { box-shadow: 0 0 0 15rpx rgba(16, 185, 129, 0); }
  100% { box-shadow: 0 0 0 0 rgba(16, 185, 129, 0); }
}

.system-time { color: var(--text-sub); font-size: 18rpx; font-weight: 700; }

.glitch-text {
  font-size: 100rpx;
  font-weight: 900;
  background: linear-gradient(180deg, var(--brand), var(--accent-violet));
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  letter-spacing: -2rpx;
  line-height: 1.1;
}

.main-label { margin-top: 8rpx; color: var(--text-sub); font-size: 22rpx; font-weight: 800; letter-spacing: 2rpx; }

.hero-stats-grid {
  display: flex;
  justify-content: space-around;
  margin-top: 40rpx;
  padding-top: 30rpx;
  border-top: 1rpx solid var(--line);
}

.h-val { font-size: 34rpx; font-weight: 900; color: var(--text-title); }
.h-label { font-size: 20rpx; font-weight: 700; color: var(--text-sub); margin-top: 2rpx; }

/* 2.网格控制区 (2x2 对称优化) */
.bento-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  grid-auto-rows: 220rpx;
  gap: 20rpx;
  padding: 0 30rpx 40rpx;
}

.bento-card {
  position: relative;
  background: var(--bg-card);
  backdrop-filter: blur(40rpx);
  border: 1rpx solid #ffffff;
  border-radius: 44rpx;
  padding: 36rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.015);
  transition: all 0.2s;
}

.bento-card:active { transform: scale(0.96); background: #ffffff; }

.bento-abstract-icon {
  width: 70rpx; height: 70rpx;
  border-radius: 24rpx;
  flex-shrink: 0;
  background-size: 38rpx 38rpx;
  background-repeat: no-repeat;
  background-position: center;
}

.bento-info {
  margin-top: 10rpx;
}

/* 留言图标 (Message) */

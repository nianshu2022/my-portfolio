.admin-monitor {
  padding-bottom: 60rpx;
}

.admin-header {
  padding: 40rpx 28rpx;
  background: linear-gradient(135deg, var(--bg-card), var(--bg-soft));
}

.admin-title {
  color: var(--text-title);
  font-size: 42rpx;
  font-weight: 900;
}

.admin-sub {
  margin-top: 6rpx;
  color: var(--text-sub);
  font-size: 24rpx;
}

.latency-card {
  padding: 40rpx;
  border-radius: var(--radius-lg);
  background: var(--bg-card);
  border: 1rpx solid var(--line);
  text-align: center;
}

.latency-val {
  font-size: 80rpx;
  font-weight: 900;
  font-family: monospace;
}

.latency-val.good { color: #10b981; }
.latency-val.medium { color: #f59e0b; }
.latency-val.poor { color: #f43f5e; }

.unit {
  font-size: 28rpx;
  opacity: 0.6;
}

.latency-label {
  margin-top: 10rpx;
  color: var(--text-sub);
  font-size: 24rpx;
}

.latency-bar {
  height: 6rpx;
  margin-top: 30rpx;
  background: var(--line);
  border-radius: 3rpx;
  overflow: hidden;
}

.bar-fill {
  height: 100%;
  background: currentColor;
  transition: width 0.3s ease;
}

.data-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

.data-item {
  padding: 30rpx;
  border-radius: var(--radius-lg);
  background: var(--bg-card);
  border: 1rpx solid var(--line);
}

.data-num {
  color: var(--text-title);
  font-size: 40rpx;
  font-weight: 900;
}

.data-name {
  margin-top: 4rpx;
  color: var(--text-sub);
  font-size: 22rpx;
}

.env-list {
  padding: 20rpx;
  border-radius: var(--radius-lg);
  background: var(--bg-soft);
}

.env-row {
  display: flex;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.env-row:last-child {
  border-bottom: none;
}

.env-label {
  color: var(--text-sub);
  font-size: 26rpx;
}

.env-val {
  color: var(--text-title);
  font-size: 26rpx;
  font-weight: 700;
}

.refresh-btn {
  width: 100% !important;
  height: 100rpx;
  margin-top: 60rpx;
  border-radius: var(--radius-md);
  color: #ffffff;
  background: linear-gradient(135deg, var(--brand), var(--accent-violet));
  font-size: 32rpx;
  font-weight: 900;
  line-height: 100rpx;
  box-shadow: 0 12rpx 30rpx var(--brand-soft);
}

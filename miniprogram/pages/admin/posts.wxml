<view class="page admin-posts">
  <view class="admin-header fade-enter">
    <view class="admin-title">文章与随笔</view>
    <view class="admin-sub">控制内容的发布状态与可见性</view>
  </view>

  <view class="post-list fade-enter" style="animation-delay: 0.1s;">
    <view class="post-card" wx:for="{{posts}}" wx:key="slug">
      <view class="post-main">
        <view class="post-info">
          <view class="type-tag {{item.type}}">{{item.type === 'post' ? '文章' : '随笔'}}</view>
          <view class="post-title">{{item.title}}</view>
          <view class="post-meta">{{item.date}} · Slug: {{item.slug}}</view>
        </view>
        <view class="post-action">
          <switch checked="{{item.published === 1}}" bindchange="togglePublish" data-slug="{{item.slug}}" color="#6366f1" />
        </view>
      </view>
      <view class="status-bar {{item.published === 1 ? 'online' : 'offline'}}">
        {{item.published === 1 ? '● 已发布' : '○ 草稿 / 已隐藏'}}
      </view>
    </view>
  </view>
</view>

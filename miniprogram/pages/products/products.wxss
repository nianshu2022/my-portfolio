.products-page {
  padding-bottom: 220rpx;
}

.products-hero::after {
  background: linear-gradient(135deg, rgba(99,102,241,0.2), rgba(251,113,133,0.16));
}

.shelf-card {
  position: relative;
  overflow: hidden;
  padding: 30rpx;
  border: 1rpx solid rgba(99,102,241,0.16);
  border-radius: var(--radius-xl);
  background: linear-gradient(135deg, rgba(255,255,255,0.94), rgba(238,242,255,0.8), rgba(255,241,242,0.72));
  box-shadow: var(--shadow-card);
}

.shelf-card::after {
  content: "";
  position: absolute;
  right: -64rpx;
  top: -74rpx;
  width: 220rpx;
  height: 220rpx;
  border-radius: 999rpx;
  background: rgba(251,113,133,0.14);
}

.shelf-kicker {
  color: var(--brand-deep);
  font-size: 22rpx;
  font-weight: 900;
  letter-spacing: 0.9px;
}

.shelf-title {
  position: relative;
  z-index: 1;
  margin-top: 12rpx;
  color: var(--text-title);
  font-size: 38rpx;
  font-weight: 900;
  line-height: 1.28;
}

.shelf-desc {
  position: relative;
  z-index: 1;
  margin-top: 12rpx;
  color: var(--text-sub);
  font-size: 26rpx;
  line-height: 1.68;
}

.product-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
}

.product-card {
  min-height: 260rpx;
  padding: 24rpx;
  border: 1rpx solid var(--line);
  border-radius: var(--radius-lg);
  background: rgba(255,255,255,0.88);
  box-shadow: var(--shadow-soft);
}

.product-card.main {
  grid-column: span 2;
  min-height: 286rpx;
  background: linear-gradient(145deg, rgba(255,255,255,0.96), rgba(238,242,255,0.78));
}

.product-card.coral {
  background: linear-gradient(145deg, rgba(255,255,255,0.94), rgba(255,241,242,0.78));
}

.product-card.mint {
  background: linear-gradient(145deg, rgba(255,255,255,0.94), rgba(220,252,231,0.72));
}

.product-badge {
  display: inline-flex;
  min-height: 44rpx;
  align-items: center;
  padding: 0 16rpx;
  border-radius: 999rpx;
  color: #ffffff;
  background: linear-gradient(135deg, var(--brand), var(--accent-violet));
  font-size: 20rpx;
  font-weight: 900;
  line-height: 44rpx;
}

.product-badge.coral {
  background: linear-gradient(135deg, #fb7185, #f97316);
}

.product-badge.mint {
  background: linear-gradient(135deg, #22c55e, #14b8a6);
}

.product-title {
  margin-top: 16rpx;
  color: var(--text-title);
  font-size: 32rpx;
  font-weight: 900;
  line-height: 1.34;
}

.product-desc {
  margin-top: 10rpx;
  color: var(--text-sub);
  font-size: 24rpx;
  line-height: 1.58;
}

.support-card {
  padding: 28rpx;
  border: 1rpx solid rgba(99,102,241,0.15);
  border-radius: var(--radius-xl);
  background: linear-gradient(135deg, rgba(255,255,255,0.92), rgba(236,253,245,0.76));
  box-shadow: var(--shadow-card);
}

.support-title {
  color: var(--text-title);
  font-size: 34rpx;
  font-weight: 900;
}

.support-desc {
  margin-top: 10rpx;
  color: var(--text-sub);
  font-size: 26rpx;
  line-height: 1.66;
}

.support-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
  margin-top: 22rpx;
}

.support-button {
  min-height: 76rpx;
  border-radius: 999rpx;
  color: var(--brand-deep);
  background: var(--brand-soft);
  font-size: 25rpx;
  font-weight: 840;
  line-height: 76rpx;
  text-align: center;
}

.support-button.primary {
  color: #ffffff;
  background: linear-gradient(135deg, var(--brand), var(--accent-violet));
  box-shadow: 0 14rpx 30rpx rgba(99,102,241,0.2);
}

.custom-card {
  background: rgba(255,255,255,0.9);
}

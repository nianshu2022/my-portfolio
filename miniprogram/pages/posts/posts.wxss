.list-page {
  padding-bottom: calc(232rpx + env(safe-area-inset-bottom));
}

.list-header {
  margin-bottom: 22rpx;
}

.feed-grid {
  display: block;
  width: calc(100vw - 56rpx);
  min-width: 0;
  max-width: calc(100vw - 56rpx);
}

.feed-card {
  position: relative;
  overflow: hidden;
  display: block;
  width: calc(100vw - 56rpx);
  min-width: 0;
  max-width: calc(100vw - 56rpx);
  margin: 0;
  box-sizing: border-box;
  padding: 24rpx 24rpx 22rpx;
  border: 1rpx solid rgba(99, 102, 241, 0.14);
  border-radius: 30rpx;
  background: linear-gradient(135deg, rgba(255,255,255,0.96), rgba(238,242,255,0.72));
  box-shadow: 0 12rpx 30rpx rgba(67, 56, 202, 0.08);
  text-align: left;
}

.feed-card + .feed-card {
  margin-top: 16rpx;
}

.feed-card::after {
  content: "";
  position: absolute;
  right: -44rpx;
  bottom: -62rpx;
  width: 170rpx;
  height: 170rpx;
  border-radius: 999rpx;
  background: rgba(99, 102, 241, 0.08);
  pointer-events: none;
}

.feed-top,
.feed-title,
.feed-desc,
.chip-row {
  position: relative;
  z-index: 1;
}

.feed-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 12rpx;
}

.feed-type {
  color: var(--brand-deep);
  font-size: 22rpx;
  font-weight: 860;
  letter-spacing: 0.8px;
}

.feed-date {
  flex: none;
  color: var(--text-sub);
  font-size: 22rpx;
}

.feed-title {
  display: -webkit-box;
  overflow: hidden;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  color: var(--text-title);
  font-size: 31rpx;
  font-weight: 860;
  line-height: 1.38;
  word-break: break-all;
}

.feed-desc {
  display: -webkit-box;
  overflow: hidden;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
  margin-top: 10rpx;
  color: var(--text-body);
  font-size: 24rpx;
  line-height: 1.66;
  word-break: break-all;
}

.chip-row {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 10rpx;
  margin-top: 18rpx;
}

.chip {
  display: inline-flex;
  max-width: 100%;
  min-height: 42rpx;
  align-items: center;
  padding: 8rpx 14rpx;
  border: 1rpx solid rgba(99, 102, 241, 0.18);
  border-radius: 999rpx;
  color: var(--text-sub);
  background: rgba(238, 242, 255, 0.76);
  font-size: 22rpx;
  font-weight: 760;
  line-height: 1.2;
}

.chip-reading {
  color: var(--brand-deep);
  background: rgba(255, 255, 255, 0.72);
}

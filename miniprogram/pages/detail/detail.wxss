.page-detail {
  min-height: 100vh;
  background: var(--bg-page);
  padding-bottom: 120rpx;
}

/* 加载状态 */
.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 0;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid var(--border-color);
  border-top-color: var(--color-primary);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-bottom: var(--space-lg);
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: var(--font-body);
  color: var(--text-muted);
}

/* 头部信息 */
.detail-header {
  background: var(--bg-card);
  border-bottom: 2rpx solid var(--border-dark);
  padding: var(--space-xl) var(--space-lg);
}

.header-meta {
  display: flex;
  align-items: center;
  gap: var(--space-md);
  margin-bottom: var(--space-lg);
}

.serial-tag {
  display: inline-flex;
  align-items: center;
  padding: 6rpx 16rpx;
  background: var(--color-primary);
  color: var(--text-inverse);
  font-family: var(--font-mono);
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.meta-date,
.meta-reading {
  font-size: var(--font-caption);
  color: var(--text-muted);
}

.detail-title {
  display: block;
  font-size: 40rpx;
  font-weight: 800;
  color: var(--text-title);
  line-height: 1.3;
  margin-bottom: var(--space-lg);
}

.detail-tags {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-sm);
}

.tag {
  display: inline-flex;
  align-items: center;
  padding: 6rpx 16rpx;
  background: var(--bg-page);
  border: 1rpx solid var(--border-color);
  font-size: 22rpx;
  color: var(--text-sub);
}

/* 正文内容 */
.detail-content {
  padding: var(--space-xl) var(--space-lg);
  background: var(--bg-card);
  margin: var(--space-md) var(--space-lg);
  border: 1rpx solid var(--border-color);
  font-size: var(--font-body);
  line-height: 1.8;
  color: var(--text-body);
}

.detail-content h2 {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-title);
  margin: var(--space-xl) 0 var(--space-md);
  padding-bottom: var(--space-sm);
  border-bottom: 2rpx solid var(--border-color);
}

.detail-content h3 {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-title);
  margin: var(--space-lg) 0 var(--space-md);
}

.detail-content p {
  margin-bottom: var(--space-md);
}

.detail-content code {
  background: var(--bg-page);
  padding: 2rpx 8rpx;
  font-family: var(--font-mono);
  font-size: 26rpx;
  color: var(--color-primary);
}

.detail-content pre {
  background: #1a1a1a;
  color: #f8f8f2;
  padding: var(--space-lg);
  margin: var(--space-lg) 0;
  overflow-x: auto;
  font-family: var(--font-mono);
  font-size: 24rpx;
  line-height: 1.5;
}

.detail-content blockquote {
  border-left: 6rpx solid var(--color-primary);
  padding: var(--space-md) var(--space-lg);
  margin: var(--space-lg) 0;
  background: var(--bg-page);
  color: var(--text-sub);
}

.detail-content ul,
.detail-content ol {
  padding-left: var(--space-xl);
  margin-bottom: var(--space-md);
}

.detail-content li {
  margin-bottom: var(--space-sm);
}

.detail-content a {
  color: var(--color-primary);
  text-decoration: underline;
}

.detail-content img {
  max-width: 100%;
  margin: var(--space-lg) 0;
}

/* 底部工具栏 */
.detail-toolbar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  justify-content: space-around;
  height: 100rpx;
  background: var(--bg-card);
  border-top: 1rpx solid var(--border-color);
  padding-bottom: env(safe-area-inset-bottom);
  z-index: 100;
}

.toolbar-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex: 1;
  height: 100%;
  background: none;
  border: none;
  padding: 0;
  margin: 0;
  line-height: 1;
}

.toolbar-item::after {
  display: none;
}

.toolbar-item:active {
  background: var(--bg-page);
}

.toolbar-item.active .toolbar-text {
  color: var(--color-primary);
}

.toolbar-icon {
  font-size: 36rpx;
  margin-bottom: 4rpx;
}

.toolbar-text {
  font-size: 20rpx;
  color: var(--text-muted);
}

.share-btn {
  font-size: 0;
}

/* 目录浮层 */
.toc-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 200;
  opacity: 0;
  visibility: hidden;
  transition: all var(--transition-normal);
}

.toc-overlay.show {
  opacity: 1;
  visibility: visible;
}

.toc-panel {
  position: absolute;
  right: 0;
  top: 0;
  bottom: 0;
  width: 60%;
  background: var(--bg-card);
  transform: translateX(100%);
  transition: transform var(--transition-normal);
}

.toc-overlay.show .toc-panel {
  transform: translateX(0);
}

.toc-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--space-lg);
  border-bottom: 1rpx solid var(--border-color);
}

.toc-title {
  font-size: var(--font-subtitle);
  font-weight: 600;
  color: var(--text-title);
}

.toc-close {
  font-size: 32rpx;
  color: var(--text-muted);
  padding: var(--space-sm);
}

.toc-list {
  height: calc(100% - 100rpx);
  padding: var(--space-lg);
}

.toc-item {
  padding: var(--space-md) 0;
  font-size: var(--font-body);
  color: var(--text-body);
  border-bottom: 1rpx dashed var(--border-color);
}

.toc-item.level-3 {
  padding-left: var(--space-lg);
  font-size: var(--font-caption);
  color: var(--text-sub);
}

.toc-item:active {
  color: var(--color-primary);
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 60rpx;
  text-align: center;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: var(--space-lg);
}

.empty-title {
  font-size: var(--font-subtitle);
  font-weight: 600;
  color: var(--text-title);
  margin-bottom: var(--space-sm);
}

.empty-desc {
  font-size: var(--font-caption);
  color: var(--text-muted);
  margin-bottom: var(--space-xl);
}

.empty-btn {
  display: inline-flex;
  align-items: center;
  padding: 16rpx 32rpx;
  background: var(--color-primary);
  color: var(--text-inverse);
  font-size: var(--font-body);
  font-weight: 600;
  letter-spacing: 2rpx;
}

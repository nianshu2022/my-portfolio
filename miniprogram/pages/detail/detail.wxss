.detail-page {
  padding-bottom: 270rpx;
}

.detail-header {
  position: relative;
  overflow: hidden;
  padding: 34rpx 28rpx;
  border: 1rpx solid var(--line);
  border-radius: var(--radius-xl);
  background: linear-gradient(135deg, var(--bg-card), var(--bg-soft));
  box-shadow: var(--shadow-soft);
}

.detail-header::after {
  content: "";
  position: absolute;
  right: -70rpx;
  top: -80rpx;
  width: 240rpx;
  height: 240rpx;
  border-radius: 999rpx;
  background: rgba(251,113,133,0.14);
}

.first-meta {
  margin-top: 0;
}

.detail-title {
  position: relative;
  z-index: 1;
  margin-top: 24rpx;
  color: var(--text-title);
  font-size: 48rpx;
  font-weight: 900;
  line-height: 1.22;
  word-break: break-word;
}

.detail-desc {
  position: relative;
  z-index: 1;
  margin-top: 18rpx;
  color: var(--text-sub);
  font-size: 28rpx;
  line-height: 1.76;
  word-break: break-word;
}

.tag-row {
  position: relative;
  z-index: 1;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 12rpx;
  margin-top: 24rpx;
}

.detail-stats {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  gap: 32rpx;
  margin-top: 32rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid rgba(0, 0, 0, 0.04);
}

.stat-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  color: var(--text-sub);
  font-size: 24rpx;
}

.stat-icon {
  font-size: 26rpx;
  opacity: 0.7;
}

.stat-value {
  font-weight: 600;
}

.tag-chip {
  display: inline-flex;
  width: auto;
  max-width: 100%;
  min-height: 46rpx;
  align-items: center;
  justify-content: center;
  padding: 8rpx 18rpx;
  border: 1rpx solid var(--line);
  border-radius: 999rpx;
  color: var(--brand-deep);
  background: var(--tag-bg);
  font-size: 23rpx;
  font-weight: 760;
  line-height: 1.2;
  white-space: nowrap;
}

.cover {
  width: 100%;
  height: 390rpx;
  margin: 26rpx 0;
  border-radius: var(--radius-xl);
  background: #eef2ff;
  box-shadow: var(--shadow-card);
}

.reader-sheet {
  margin-top: 26rpx;
  padding: 34rpx 28rpx 12rpx;
  border: 1rpx solid var(--line);
  border-radius: var(--radius-xl);
  background: var(--bg-card);
  box-shadow: var(--shadow-card);
}

.markdown {
  display: block;
  color: var(--text-body);
  font-size: 30rpx;
  line-height: 1.9;
}

.md-p {
  margin: 0 0 30rpx;
}

.md-h {
  margin: 54rpx 0 18rpx;
  color: var(--text-title);
  font-weight: 900;
  line-height: 1.32;
}

.md-h1 { font-size: 42rpx; }
.md-h2 { font-size: 37rpx; }
.md-h3,
.md-h4 { font-size: 32rpx; }

.md-quote {
  display: block;
  margin: 26rpx 0;
  padding: 22rpx 24rpx;
  border-left: 7rpx solid var(--brand);
  border-radius: var(--radius-md);
  color: var(--text-body);
  background: var(--brand-soft);
}

.md-code {
  display: block;
  margin: 26rpx 0;
  padding: 24rpx;
  border-radius: var(--radius-md);
  color: var(--text-body);
  background: #15182e;
  font-family: Menlo, Consolas, monospace;
  font-size: 24rpx;
  line-height: 1.68;
  white-space: pre-wrap;
  word-break: break-word;
}

.md-img {
  display: block;
  max-width: 100%;
  margin: 24rpx auto;
  border-radius: var(--radius-lg);
}

.md-li {
  margin: 0 0 17rpx;
}

.md-hr {
  margin: 36rpx 0;
  border: 0;
  border-top: 1rpx solid rgba(99, 102, 241, 0.18);
}

.next-card {
  position: relative;
  overflow: hidden;
  margin: 30rpx 0 18rpx;
  padding: 28rpx;
  border: 1rpx solid var(--line);
  border-radius: var(--radius-xl);
  background: linear-gradient(135deg, var(--bg-card), var(--bg-soft));
  box-shadow: var(--shadow-card);
}

.next-card::after {
  content: "";
  position: absolute;
  right: -50rpx;
  bottom: -70rpx;
  width: 190rpx;
  height: 190rpx;
  border-radius: 999rpx;
  background: rgba(34,197,94,0.16);
}

.next-kicker {
  color: #15803d;
  font-size: 22rpx;
  font-weight: 900;
  letter-spacing: 0.8px;
}

.next-title {
  position: relative;
  z-index: 1;
  margin-top: 12rpx;
  color: var(--text-title);
  font-size: 34rpx;
  font-weight: 900;
  line-height: 1.36;
}

.next-desc {
  position: relative;
  z-index: 1;
  margin-top: 10rpx;
  color: var(--text-sub);
  font-size: 24rpx;
}

/* 底部工具栏 */
.detail-toolbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 998;
  pointer-events: none;
}

.toolbar-surface {
  display: flex;
  width: 100%;
  gap: 20rpx;
  padding: 10rpx 24rpx env(safe-area-inset-bottom);
  border-top: 1rpx solid var(--line);
  background: var(--bg-glass);
  box-shadow: 0 -8rpx 32rpx rgba(0, 0, 0, 0.12);
  backdrop-filter: blur(20rpx);
  pointer-events: auto;
  box-sizing: border-box;
}

.toolbar-button {
  flex: 1;
  display: flex;
  min-width: 0;
  min-height: 80rpx;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  border-radius: var(--radius-md);
  color: var(--text-sub);
  background: var(--bg-soft);
  text-align: center;
  transition: all 160ms ease;
}

.toolbar-icon {
  color: currentColor;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1;
}

.toolbar-label {
  color: currentColor;
  font-size: 24rpx;
  font-weight: 780;
  line-height: 1;
}

.toolbar-button.active {
  color: #ffffff;
}

.toolbar-button.liked {
  background: linear-gradient(135deg, #fb7185, #f43f5e);
  box-shadow: 0 12rpx 26rpx rgba(244, 63, 94, 0.24);
}

.toolbar-button.saved {
  background: linear-gradient(135deg, #6366f1, #8b5cf6);
  box-shadow: 0 12rpx 26rpx rgba(99, 102, 241, 0.23);
}

/* 留言板样式 */
.detail-comments {
  margin-top: 30rpx;
  padding: 34rpx 28rpx;
  border: 1rpx solid var(--line);
  border-radius: var(--radius-xl);
  background: var(--bg-card);
}

.comment-header {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 30rpx;
}

.comment-title {
  color: var(--text-title);
  font-size: 34rpx;
  font-weight: 900;
}

.comment-count {
  color: var(--text-sub);
  font-size: 22rpx;
}

.comment-list {
  display: flex;
  flex-direction: column;
  gap: 30rpx;
}

.comment-item {
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid rgba(0,0,0,0.03);
}

.comment-user {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.avatar-mini {
  width: 54rpx;
  height: 54rpx;
  border-radius: 999rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #6366f1, #8b5cf6);
  font-size: 24rpx;
  font-weight: 900;
  line-height: 54rpx;
  text-align: center;
}

.user-info {
  display: flex;
  flex-direction: column;
}

.user-name {
  color: var(--text-title);
  font-size: 26rpx;
  font-weight: 800;
}

.comment-time {
  margin-top: 2rpx;
  color: var(--text-sub);
  font-size: 20rpx;
}

.comment-content {
  margin-top: 12rpx;
  padding-left: 70rpx;
  color: var(--text-body);
  font-size: 27rpx;
  line-height: 1.6;
}

.admin-reply-box {
  margin: 16rpx 0 0 70rpx;
  padding: 16rpx 20rpx;
  border-left: 6rpx solid var(--brand);
  border-radius: 8rpx;
  background: var(--brand-soft);
}

.reply-header {
  color: var(--brand);
  font-size: 22rpx;
  font-weight: 900;
  margin-bottom: 6rpx;
}

.reply-body {
  color: var(--text-body);
  font-size: 25rpx;
  line-height: 1.5;
}

.comment-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 0;
}

.empty-icon {
  margin-bottom: 12rpx;
  font-size: 48rpx;
  opacity: 0.4;
}

.empty-text {
  color: var(--text-sub);
  font-size: 24rpx;
}

.write-comment-btn {
  width: 100% !important;
  height: 84rpx;
  margin-top: 40rpx;
  border: 1rpx solid var(--line);
  border-radius: 999rpx;
  color: var(--brand-deep);
  background: var(--brand-soft);
  font-size: 26rpx;
  font-weight: 800;
  line-height: 84rpx;
  text-align: center;
}

/* 评论弹窗 */
.comment-sheet {
  position: fixed;
  inset: 0;
  z-index: 2000;
  visibility: hidden;
  transition: all 0.3s ease;
}

.comment-sheet.visible {
  visibility: visible;
}

.sheet-mask {
  position: absolute;
  inset: 0;
  background: rgba(0,0,0,0.5);
  opacity: 0;
  transition: opacity 0.3s ease;
}

.comment-sheet.visible .sheet-mask {
  opacity: 1;
}

.sheet-content {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 34rpx 34rpx calc(34rpx + env(safe-area-inset-bottom));
  border-radius: 40rpx 40rpx 0 0;
  background: var(--bg-card);
  transform: translateY(100%);
  transition: transform 0.3s cubic-bezier(0.23, 1, 0.32, 1);
}

.comment-sheet.visible .sheet-content {
  transform: translateY(0);
}

.sheet-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 40rpx;
  color: var(--text-title);
  font-size: 34rpx;
  font-weight: 900;
}

.sheet-close {
  padding: 10rpx;
  color: var(--text-sub);
  font-size: 40rpx;
}

.nickname-input {
  width: 100%;
  height: 88rpx;
  margin-bottom: 24rpx;
  padding: 0 28rpx;
  border: 1rpx solid var(--line);
  border-radius: var(--radius-md);
  background: var(--bg-soft);
  box-sizing: border-box;
}

.content-input {
  width: 100%;
  height: 240rpx;
  margin-bottom: 40rpx;
  padding: 24rpx 28rpx;
  border: 1rpx solid var(--line);
  border-radius: var(--radius-md);
  background: var(--bg-soft);
  box-sizing: border-box;
}

.submit-btn {
  width: 100% !important;
  height: 94rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-md);
  color: #ffffff;
  background: #e2e8f0;
  font-size: 30rpx;
  font-weight: 900;
  padding: 0;
  margin: 0;
  transition: all 0.2s ease;
}

.submit-btn.active {
  background: linear-gradient(135deg, var(--brand), var(--accent-violet));
  box-shadow: 0 10rpx 24rpx var(--brand-soft);
}

.submit-btn:active {
  transform: scale(0.98);
  opacity: 0.9;
}

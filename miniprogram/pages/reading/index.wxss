.reading-hero {
  position: relative;
  overflow: hidden;
  padding: 34rpx 30rpx;
  border: 1rpx solid var(--line);
  border-radius: var(--radius-xl);
  background: linear-gradient(135deg, var(--bg-card), var(--bg-soft));
  box-shadow: var(--shadow-card);
}

@media (prefers-color-scheme: dark) {
  .reading-hero {
    background: linear-gradient(135deg, #1e293b 0%, #1e1b4b 100%);
  }
}

.reading-hero::after {
  content: "";
  position: absolute;
  right: -50rpx;
  top: -60rpx;
  width: 210rpx;
  height: 210rpx;
  border-radius: 999rpx;
  background: rgba(34,197,94,0.16);
}

.reading-kicker {
  color: #15803d;
  font-size: 21rpx;
  font-weight: 900;
  letter-spacing: 1px;
}

.reading-title {
  margin-top: 10rpx;
  color: var(--text-title);
  font-size: 48rpx;
  font-weight: 900;
}

.reading-sub {
  margin-top: 12rpx;
  color: var(--text-sub);
  font-size: 26rpx;
  line-height: 1.68;
}

.reading-stats {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12rpx;
  margin-top: 24rpx;
}

.reading-stats view {
  min-width: 0;
  padding: 14rpx 8rpx;
  border-radius: 24rpx;
  background: var(--bg-elevated);
  text-align: center;
}

.reading-stats text {
  display: block;
}

.reading-stats text:first-child {
  color: var(--text-title);
  font-size: 34rpx;
  font-weight: 900;
}

.reading-stats text:last-child {
  color: var(--text-sub);
  font-size: 22rpx;
}

.reading-tabs {
  position: sticky;
  top: 0;
  z-index: 4;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 10rpx;
  padding: 10rpx;
  border-radius: 999rpx;
  background: var(--bg-glass);
  box-shadow: var(--shadow-soft);
  backdrop-filter: blur(20rpx);
}

.reading-tab {
  min-height: 62rpx;
  border-radius: 999rpx;
  color: var(--text-sub);
  font-size: 23rpx;
  font-weight: 820;
  line-height: 62rpx;
  text-align: center;
}

.reading-tab.active {
  color: #ffffff;
  background: linear-gradient(135deg, var(--brand), var(--accent-violet));
}

.feed-card {
  display: block;
  width: 100%;
  min-width: 0;
  margin: 0;
  padding: 24rpx 24rpx 22rpx;
  border: 1rpx solid var(--line);
  border-radius: 30rpx;
  background: linear-gradient(135deg, var(--bg-card), var(--bg-soft));
  box-shadow: var(--shadow-soft);
  text-align: left;
}

.feed-card + .feed-card {
  margin-top: 16rpx;
}

.feed-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.feed-type { color: var(--brand-deep); font-size: 22rpx; font-weight: 860; }
.feed-date { color: var(--text-sub); font-size: 22rpx; }
.feed-title {
  display: -webkit-box;
  overflow: hidden;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  color: var(--text-title);
  font-size: 31rpx;
  font-weight: 860;
  line-height: 1.38;
  word-break: break-all;
}
.feed-desc {
  display: -webkit-box;
  overflow: hidden;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
  margin-top: 10rpx;
  color: var(--text-body);
  font-size: 24rpx;
  line-height: 1.58;
  word-break: break-all;
}

.chip-row { display: flex; flex-wrap: wrap; gap: 8rpx; margin-top: 16rpx; }
.chip { padding: 7rpx 13rpx; border: 1rpx solid rgba(99,102,241,0.15); border-radius: 999rpx; color: var(--text-sub); background: var(--tag-bg); font-size: 21rpx; }
.chip-reading { border-color: rgba(34,197,94,0.2); color: #15803d; background: #ecfdf5; }

.empty-action {
  width: 240rpx;
  margin: 24rpx auto 0;
}

.clear-button {
  width: 260rpx;
  min-height: 70rpx;
  margin: 26rpx auto 0;
  border-radius: 999rpx;
  color: var(--text-sub);
  background: var(--bg-glass);
  font-size: 24rpx;
  line-height: 70rpx;
  text-align: center;
}

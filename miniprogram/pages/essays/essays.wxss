.page-essays {
  min-height: 100vh;
  background: var(--bg-page);
}

.page-header {
  background: var(--bg-card);
  border-bottom: 2rpx solid var(--border-dark);
  padding: var(--space-2xl) var(--space-lg);
}

.page-title {
  display: block;
  font-size: 40rpx;
  font-weight: 800;
  color: var(--text-title);
  letter-spacing: 4rpx;
  margin-bottom: var(--space-sm);
}

.page-desc {
  font-size: var(--font-body);
  color: var(--text-sub);
}

.essays-list {
  padding: var(--space-lg);
}

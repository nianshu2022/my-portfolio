<view class="page-essays">
  <!-- 页面标题 -->
  <view class="page-header">
    <view class="header-left">
      <text class="header-code">SMP</text>
      <text class="header-title">成长样本</text>
    </view>
  </view>

  <view class="page-desc">
    <text>把阶段经历留下来，让技术之外的选择也能被看见</text>
  </view>

  <view class="essays-list">
    <skeleton-list wx:if="{{loading}}" count="3" />

    <block wx:elif="{{essays.length > 0}}">
      <case-card
        wx:for="{{essays}}"
        wx:key="slug"
        title="{{item.title}}"
        date="{{item.date}}"
        tags="{{item.tags}}"
        caseNumber="SMP-{{index + 1}}"
        excerpt="{{item.description}}"
        type="essay"
        slug="{{item.slug}}"
        bindtap="onEssayTap"
      />
    </block>

    <empty-state 
      wx:else 
      icon="empty" 
      title="暂无成长样本" 
      desc="正在记录中，敬请期待" 
    />
  </view>
</view>

.tab-host {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
  height: 168rpx;
  padding: 16rpx 26rpx calc(18rpx + env(safe-area-inset-bottom));
  pointer-events: none;
}

.tab-blur {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 150rpx;
  background: linear-gradient(180deg, rgba(255,255,255,0), var(--bg-page));
}

@media (prefers-color-scheme: dark) {
  .tab-blur {
    background: linear-gradient(180deg, rgba(15,23,42,0), #0f172a);
  }
}

.tab-shell {
  position: relative;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 10rpx;
  height: 102rpx;
  padding: 10rpx;
  border: 1rpx solid var(--line);
  border-radius: 999rpx;
  background: var(--bg-elevated);
  box-shadow: var(--shadow-card);
  backdrop-filter: blur(20rpx);
  pointer-events: auto;
}

.tab-item {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  min-width: 0;
  border-radius: 999rpx;
  color: var(--text-sub);
}

.tab-item.active {
  color: #ffffff;
  background: linear-gradient(135deg, var(--brand), var(--accent-violet) 62%, var(--accent-mint));
  box-shadow: 0 12rpx 26rpx rgba(99, 102, 241, 0.24);
}

.tab-orb {
  display: flex;
  width: 34rpx;
  height: 34rpx;
  align-items: center;
  justify-content: center;
  border: 1rpx solid var(--line);
  border-radius: 999rpx;
  background: var(--bg-soft);
  font-size: 18rpx;
  font-weight: 900;
  line-height: 34rpx;
}

.tab-item.active .tab-orb {
  color: #4338ca;
  border-color: rgba(255, 255, 255, 0.58);
  background: rgba(255, 255, 255, 0.92);
}

.tab-text {
  font-size: 24rpx;
  font-weight: 820;
  line-height: 1;
}

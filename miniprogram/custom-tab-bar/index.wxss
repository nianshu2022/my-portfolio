.tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 100;
  background: #ffffff;
  border-top: 1rpx solid #e5e5e5;
  padding-bottom: env(safe-area-inset-bottom);
}

.tab-bar-inner {
  display: flex;
  align-items: center;
  justify-content: space-around;
  height: 100rpx;
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
  padding: 10rpx 0;
}

.tab-icon-wrap {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 4rpx;
}

.tab-icon {
  width: 44rpx;
  height: 44rpx;
  position: relative;
}

/* 案卷图标 */
.icon-doc {
  border: 3rpx solid #999;
  border-radius: 4rpx;
}
.icon-doc::before {
  content: '';
  position: absolute;
  top: 8rpx;
  left: 6rpx;
  right: 6rpx;
  height: 3rpx;
  background: #999;
}
.icon-doc::after {
  content: '';
  position: absolute;
  top: 16rpx;
  left: 6rpx;
  right: 10rpx;
  height: 3rpx;
  background: #999;
}
.icon-doc.active {
  border-color: #b4232a;
}
.icon-doc.active::before,
.icon-doc.active::after {
  background: #b4232a;
}

/* 索引图标 */
.icon-index {
  border: 3rpx solid #999;
  border-radius: 4rpx;
}
.icon-index::before {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 16rpx;
  height: 16rpx;
  border: 3rpx solid #999;
}
.icon-index.active {
  border-color: #b4232a;
}
.icon-index.active::before {
  border-color: #b4232a;
}

/* 样本图标 */
.icon-essay {
  border: 3rpx solid #999;
  border-radius: 4rpx;
}
.icon-essay::before {
  content: '';
  position: absolute;
  top: 8rpx;
  left: 6rpx;
  right: 6rpx;
  height: 3rpx;
  background: #999;
}
.icon-essay::after {
  content: '';
  position: absolute;
  top: 16rpx;
  left: 6rpx;
  right: 10rpx;
  height: 3rpx;
  background: #999;
}
.icon-essay.active {
  border-color: #b4232a;
}
.icon-essay.active::before,
.icon-essay.active::after {
  background: #b4232a;
}

/* 档案图标 */
.icon-archive {
  border: 3rpx solid #999;
  border-bottom: none;
  border-radius: 4rpx 4rpx 0 0;
}
.icon-archive::before {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 3rpx;
  background: #999;
}
.icon-archive::after {
  content: '';
  position: absolute;
  top: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 16rpx;
  height: 8rpx;
  border: 3rpx solid #999;
  border-bottom: none;
  border-radius: 4rpx 4rpx 0 0;
  background: #ffffff;
}
.icon-archive.active {
  border-color: #b4232a;
}
.icon-archive.active::before,
.icon-archive.active::after {
  border-color: #b4232a;
}

.tab-text {
  font-size: 20rpx;
  color: #999;
  font-weight: 500;
  transition: color 0.2s;
}

.tab-item.active .tab-text {
  color: #b4232a;
  font-weight: 600;
}

.tab-indicator {
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 32rpx;
  height: 4rpx;
  background: #b4232a;
  border-radius: 2rpx;
}

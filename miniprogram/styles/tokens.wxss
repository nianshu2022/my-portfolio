/* 念舒档案局 - 设计系统 */

page {
  /* 主色调 */
  --color-primary: #b4232a;
  --color-primary-dark: #8a1a20;
  --color-primary-light: #d44a52;
  
  /* 背景色 */
  --bg-page: #f5f0e8;
  --bg-card: #ffffff;
  --bg-grid: #e8e0d4;
  --bg-stamp: #b4232a;
  
  /* 文字色 */
  --text-title: #1a1a1a;
  --text-body: #2d2d2d;
  --text-sub: #6b6b6b;
  --text-muted: #9a9a9a;
  --text-inverse: #ffffff;
  
  /* 边框 */
  --border-color: #d4cec4;
  --border-dark: #1a1a1a;
  
  /* 功能色 */
  --color-success: #22c55e;
  --color-warning: #f59e0b;
  --color-error: #ef4444;
  --color-info: #3b82f6;
  
  /* 字体 */
  --font-title: 34rpx;
  --font-subtitle: 30rpx;
  --font-body: 28rpx;
  --font-caption: 24rpx;
  --font-mono: 'Courier New', monospace;
  
  /* 间距 */
  --space-xs: 8rpx;
  --space-sm: 12rpx;
  --space-md: 16rpx;
  --space-lg: 24rpx;
  --space-xl: 32rpx;
  --space-2xl: 48rpx;
  
  /* 圆角 */
  --radius-sm: 4rpx;
  --radius-md: 8rpx;
  --radius-lg: 12rpx;
  
  /* 阴影 */
  --shadow-sm: 0 2rpx 4rpx rgba(0, 0, 0, 0.05);
  --shadow-md: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
  --shadow-lg: 0 8rpx 24rpx rgba(0, 0, 0, 0.12);
  
  /* 动画 */
  --transition-fast: 150ms ease;
  --transition-normal: 250ms ease;
  --transition-slow: 400ms ease;
}

/*
 * Cloudflare Pages security & cache headers
 * Docs: https://developers.cloudflare.com/pages/configuration/headers/
 */

# ── Apply to every response ──────────────────────────────────────────────────
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  X-XSS-Protection: 1; mode=block
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  # Allow embedding for Giscus comments iframe (github.com)
  Content-Security-Policy: frame-ancestors 'self' https://giscus.app

# ── Static assets – long-lived cache ─────────────────────────────────────────
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

/img/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

/favicon.png
  Cache-Control: public, max-age=604800

# ── API / dynamic json – short cache ─────────────────────────────────────────
/api/*
  Cache-Control: no-store

/portal-status.json
  Cache-Control: public, max-age=60, stale-while-revalidate=120

/feed.xml
  Cache-Control: public, max-age=3600, stale-while-revalidate=1800
  Content-Type: application/xml; charset=utf-8
